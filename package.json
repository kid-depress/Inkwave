{
  "name": "inkwave",
  "productName": "INKWAVE",
  "version": "1.1.0",
  "description": "An original Splatoon-style 4v4 turf-war shooter for the browser, built on three.js.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node tools/py.mjs tools/serve.py",
    "check": "node tools/check-syntax.mjs",
    "test-i18n": "node tools/test-i18n.mjs",
    "test-desktop-server": "node tools/test-desktop-server.mjs",
    "test-pointer-capture": "node tools/test-pointer-capture.mjs",
    "test-desktop": "node tools/test-desktop.mjs",
    "package": "node tools/package-desktop.mjs",
    "package:win": "node tools/package-desktop.mjs --platform=win32 --arch=x64",
    "package:mac": "node tools/package-desktop.mjs --platform=darwin --arch=arm64,x64",
    "music": "node build/music-manifest.mjs",
    "prestart": "npm run -s music",
    "prepackage": "npm run -s check && npm run -s music",
    "prepackage:win": "npm run -s check && npm run -s music",
    "prepackage:mac": "npm run -s check && npm run -s music",
    "bake": "electron build/bake-ao.cjs",
    "check-maps": "node build/check-maps.mjs",
    "icon": "sh build/make-icon.sh",
    "botlab": "tools/botlab/run.sh tools/botlab/match.cjs",
    "smoke": "./tools/smoke.sh",
    "net-test": "node tools/net-test.mjs",
    "build": "node tools/py.mjs tools/build-dist.py",
    "release": "./tools/release-pages.sh",
    "deploy-relay": "cd server && wrangler deploy",
    "relay": "cd server && wrangler dev --ip 0.0.0.0 --port 8787"
  },
  "keywords": [
    "game",
    "three.js",
    "webgl",
    "shooter",
    "splatoon",
    "turf-war",
    "browser-game"
  ],
  "author": "Jayden Davis",
  "license": "MIT",
  "type": "module",
  "homepage": "https://inkwave-aah.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaydendavisnc/inkwave.git"
  },
  "bugs": {
    "url": "https://github.com/jaydendavisnc/inkwave/issues"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "puppeteer-core": "^25.12.0",
    "wrangler": "^4.141.0"
  }
}
